# Keep empty directory markers.
!BioSeqBench/raw_data/.gitkeep
!BioSeqBench/dataset/.gitkeep
!BioSeqBench/checkpoints/.gitkeep
!BioSeqBench/logs/.gitkeep
!BioSeqBench/results/.gitkeep
