# Python/build/editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# Local scratch files can be many gigabytes.
tmp/

# Generated BioSeqBench data, training outputs, and reports.
BioSeqBench/raw_data/**
BioSeqBench/dataset/**
BioSeqBench/checkpoints/**
BioSeqBench/logs/**
BioSeqBench/results/**
BioSeqBench/reports/**

# Keep empty directory markers.
!BioSeqBench/raw_data/.gitkeep
!BioSeqBench/dataset/.gitkeep
!BioSeqBench/checkpoints/.gitkeep
!BioSeqBench/logs/.gitkeep
!BioSeqBench/results/.gitkeep
!BioSeqBench/reports/.gitkeep

